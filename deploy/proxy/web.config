<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for Cruise Bingo.
  Place this web.config in the document root (e.g. Plesk httpdocs, or the
  IIS site's physical path) of the site bound to bingo.pssgroup.app.

  Requires on the server (one-time, server-wide):
    - URL Rewrite module
    - Application Request Routing (ARR) 3.0, with "Enable proxy" turned ON
      (IIS Manager > server node > Application Request Routing Cache >
       Server Proxy Settings > tick "Enable proxy")
    - "WebSocket Protocol" Windows feature installed

  The Node app must be running on 127.0.0.1:3000 (scheduled task CruiseBingo).
-->
<configuration>
  <system.webServer>
    <!-- Disable IIS's own WebSocket module so ARR proxies the Upgrade through -->
    <webSocket enabled="false" />
    <rewrite>
      <rules>
        <rule name="CruiseBingoProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Don't let IIS serve static files from this folder; everything proxies -->
    <defaultDocument enabled="false" />
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
